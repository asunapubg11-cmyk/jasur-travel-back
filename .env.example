# Nusxa oling: .env deb nomlang va qiymatlarni to'ldiring. .env ni GitHub'ga YUKLAMANG.
# SECRET_KEY yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ikkalasi ham Supabase "Session pooler" (port 5432). Parolda ! @ # kabi belgilar bo'lsa %21 %40 %23 deb kodlang.
DATABASE_URL=postgresql://postgres.<LOYIHA_ID>:<PAROL>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<LOYIHA_ID>:<PAROL>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<LOYIHA_ID>.supabase.co
# Project Settings -> API -> service_role (219 belgi, bitta qatorda)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# JSON ro'yxat: qo'sh tirnoq va kvadrat qavs bilan
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
